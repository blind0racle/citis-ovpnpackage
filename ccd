#!/bin/bash
# ccd – list/view/append OpenVPN CCD files

CCD_DIR="/etc/openvpn/server/ccd"

if [ ! -d "$CCD_DIR" ]; then
    echo "Error: CCD directory not found: $CCD_DIR" >&2
    exit 1
fi

list_users() {
    local i=1
    for f in "$CCD_DIR"/*; do
        if [ -f "$f" ]; then
            username=$(basename "$f")
            ip=$(grep -m1 '^ifconfig-push' "$f" | awk '{print $2}' 2>/dev/null)
            if [ -n "$ip" ]; then
                echo "$i. $username - $ip"
            else
                echo "$i. $username - (no IP)"
            fi
            ((i++))
        fi
    done
}

view_user() {
    local target="$1"
    local file=""

    if [[ "$target" =~ ^[0-9]+$ ]]; then
        file=$(ls -1 "$CCD_DIR"/* 2>/dev/null | sed -n "${target}p")
    else
        file="$CCD_DIR/$target"
    fi

    if [ -z "$file" ] || [ ! -f "$file" ]; then
        echo "Error: User not found: $target" >&2
        exit 1
    fi

    echo "=== $(basename "$file") ==="
    cat "$file"
}

append_route() {
    local username="$1"
    local ip="$2"
    local file="$CCD_DIR/$username"

    if [ -z "$username" ] || [ -z "$ip" ]; then
        echo "Usage: ccd --append <username> <ip>" >&2
        exit 1
    fi

    if [ ! -f "$file" ]; then
        echo "Error: User CCD file not found: $file" >&2
        exit 1
    fi

    # Determine netmask: if last octet is 0 -> /24, else /32
    local netmask
    if [[ "$ip" =~ \.0$ ]]; then
        netmask="255.255.255.0"
    else
        netmask="255.255.255.255"
    fi

    local route_line="push \"route $ip $netmask\""

    # Check if already exists
    if grep -qF "$route_line" "$file"; then
        echo "Route already exists in $username: $route_line"
        exit 0
    fi

    echo "$route_line" >> "$file"
    echo "Appended to $username: $route_line"
}

case "$1" in
    -h|--help)
        echo "Usage: ccd [OPTION] [ARGUMENTS]"
        echo ""
        echo "Options:"
        echo "  (no args)                 List all users with their IPs"
        echo "  NUMBER                    Show CCD file for Nth user"
        echo "  USERNAME                  Show CCD file for that user"
        echo "  -a, --append USER IP      Append route to USER's CCD file"
        echo "  -h, --help                Show this help"
        ;;
    -a|--append)
        append_route "$2" "$3"
        ;;
    "")
        list_users
        ;;
    *)
        view_user "$1"
        ;;
esac